generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoItem {
  SALDO
  EXTRA
  CONTA
  EXTRA_MES
  ANUAL
}

enum PapelExtra {
  VALE_TRANSPORTE
  VALE_ALIMENTACAO
  PROVENTO_FUNDO
  PROVENTO_POUPANCA
  OUTRO
}

enum FinalidadeConta {
  INVESTIMENTO
  POUPANCA
  META
  EMPRESA
  RESERVA
}

enum TipoRenda {
  EMPREGO
  BICO
  RENDIMENTO
  VALE_TRANSPORTE
  VALE_ALIMENTACAO
}

enum TitularRenda {
  EU
  CONJUGE
}

enum LadoContaAnual {
  CASA
  EMPRESA
}

model MesFinanceiro {
  id              String            @id @default(cuid())
  competencia     String            @unique
  feiraReal       Decimal           @default(0) @db.Decimal(12, 2)
  cartaoReal      Decimal           @default(0) @db.Decimal(12, 2)
  gasolinaReal    Decimal           @default(0) @db.Decimal(12, 2)
  fundoReal       Decimal           @default(0) @db.Decimal(12, 2)
  alttabReal      Decimal           @default(100) @db.Decimal(12, 2)
  poupancaReal         Decimal           @default(0) @db.Decimal(12, 2)
  poupancaEditado      Boolean           @default(false)
  fundoEditado         Boolean           @default(false)
  alttabEditado        Boolean           @default(false)
  poupancaDepositado   Boolean           @default(false)
  fundoDepositado      Boolean           @default(false)
  alttabDepositado     Boolean           @default(false)
  metaDepositado       Boolean           @default(false)
  cartaoPago           Boolean           @default(false)
  poupancaCreditado    Decimal           @default(0) @db.Decimal(12, 2)
  fundoCreditado       Decimal           @default(0) @db.Decimal(12, 2)
  alttabCreditado      Decimal           @default(0) @db.Decimal(12, 2)
  metaCreditado        Decimal           @default(0) @db.Decimal(12, 2)
  sobraAnteriorConfirmada Boolean        @default(false)
  fechado              Boolean           @default(false)
  fechadoEm       DateTime?
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt
  itens           ItemFinanceiro[]
}

model ItemFinanceiro {
  id           String      @id @default(cuid())
  mesId        String
  mes          MesFinanceiro @relation(fields: [mesId], references: [id], onDelete: Cascade)
  tipo         TipoItem
  nome         String
  valor        Decimal     @default(0) @db.Decimal(12, 2)
  papel        PapelExtra?
  ordem        Int         @default(0)
  pago         Boolean     @default(false)
  fonteRendaId String?
  fonteRenda   FonteRenda? @relation(fields: [fonteRendaId], references: [id], onDelete: SetNull)
  contaAnualId String?
  contaAnual   ContaAnual? @relation(fields: [contaAnualId], references: [id], onDelete: Cascade)

  @@index([mesId, tipo])
  @@index([fonteRendaId])
  @@index([contaAnualId])
}

model ContaBancaria {
  id             String           @id @default(cuid())
  nome           String
  finalidade     FinalidadeConta
  saldo          Decimal          @default(0) @db.Decimal(12, 2)
  meta           Decimal?         @db.Decimal(12, 2)
  metaMensal     Decimal?         @db.Decimal(12, 2)
  banco          String           @default("")
  titular        String           @default("")
  chavePix       String           @default("")
  qrCode         String           @default("")
  recebePoupanca Boolean          @default(false)
  ordem          Int              @default(0)
  criadoEm       DateTime         @default(now())
  atualizadoEm   DateTime         @updatedAt
  emprestimos    EmprestimoMeta[]
  gastosEmpresa  GastoEmpresa[]
  transacoes     Transacao[]

  @@index([ordem])
}

model GastoEmpresa {
  id           String        @id @default(cuid())
  nome         String
  nota         String        @default("")
  valor        Decimal       @db.Decimal(12, 2)
  competencia  String
  contaId      String
  conta        ContaBancaria @relation(fields: [contaId], references: [id], onDelete: Restrict)
  ordem        Int           @default(0)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@index([contaId])
  @@index([competencia])
}

model EmprestimoMeta {
  id                String        @id @default(cuid())
  nome              String
  valorTotal        Decimal       @db.Decimal(12, 2)
  parcelas          Int
  valorParcela      Decimal       @db.Decimal(12, 2)
  competenciaInicio String
  pagoTotal         Decimal       @default(0) @db.Decimal(12, 2)
  contaId           String
  conta             ContaBancaria @relation(fields: [contaId], references: [id], onDelete: Restrict)
  ordem             Int           @default(0)
  criadoEm          DateTime      @default(now())
  atualizadoEm      DateTime      @updatedAt

  @@index([contaId])
  @@index([competenciaInicio])
}

model FonteRenda {
  id           String           @id @default(cuid())
  nome         String
  tipo         TipoRenda
  titular      TitularRenda     @default(EU)
  ordem        Int              @default(0)
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt
  itens        ItemFinanceiro[]

  @@index([ordem])
}

model CompraCartao {
  id                 String   @id @default(cuid())
  nome               String
  valorTotal         Decimal  @db.Decimal(12, 2)
  parcelas           Int
  valorParcela       Decimal  @db.Decimal(12, 2)
  competenciaInicio  String
  ordem              Int      @default(0)
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  @@index([competenciaInicio])
}

model RecorrenteCartao {
  id           String   @id @default(cuid())
  nome         String
  valor        Decimal  @db.Decimal(12, 2)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ordem])
}

model ContaAnual {
  id           String         @id @default(cuid())
  nome         String
  valor        Decimal        @db.Decimal(12, 2)
  dia          Int            @default(1)
  mes          Int
  parcelas     Int            @default(1)
  valorParcela Decimal        @db.Decimal(12, 2)
  lado         LadoContaAnual @default(CASA)
  banco        String         @default("")
  chavePix     String         @default("")
  ordem        Int            @default(0)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  itens        ItemFinanceiro[]

  @@index([mes])
  @@index([ordem])
}

model PreferenciaCasa {
  id                     String   @id @default("casa")
  metaRendimentoPassivo  Decimal? @db.Decimal(12, 2)
  gastoPessoalMes        Decimal? @db.Decimal(12, 2)
  destinoCartaoNome      String   @default("")
  destinoCartaoChave     String   @default("")
  diaFechamentoCartao    Int      @default(7)
  atualizadoEm           DateTime @updatedAt
}

/// Histórico de movimentações de saldo das caixinhas. Valor com sinal: positivo entra, negativo sai.
model Transacao {
  id          String        @id @default(cuid())
  data        DateTime      @default(now())
  tipo        String
  descricao   String
  valor       Decimal       @db.Decimal(12, 2)
  competencia String
  contaId     String
  conta       ContaBancaria @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId])
  @@index([data])
  @@index([competencia])
}

/// Lançamentos avulsos de gasto variável (feira, gasolina, cartão avulso). A soma do mês fica em MesFinanceiro.
model LancamentoVariavel {
  id          String   @id @default(cuid())
  competencia String
  categoria   String
  valor       Decimal  @db.Decimal(12, 2)
  descricao   String   @default("")
  data        DateTime @default(now())

  @@index([competencia, categoria])
}
